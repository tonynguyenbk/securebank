# Copy to .env and fill in. .env is git-ignored — never commit real secrets.
# Generate a JWT secret with:  openssl rand -base64 48

# --- Shared secrets ---
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-bytes

# --- PostgreSQL (one container, five databases) ---
DB_USERNAME=securebank
DB_PASSWORD=change-me-local-db-password
# Host port. 5433 avoids clashing with a locally installed PostgreSQL on 5432.
POSTGRES_PORT=5433

# --- Redis / Kafka (host ports for local development) ---
REDIS_PORT=6379
KAFKA_PORT=9092

# --- Demo data ---
# Seeds the demo users/accounts from spec §30 (customer1, staff1, ...). Local demo only.
SECUREBANK_DEMO_SEED=true

# --- Frontend / gateway ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
