                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"demo.{{$timestamp}}\",\n  \"password\": \"Demo@12345\",\n  \"fullName\": \"Lê Thị Demo\",\n  \"email\": \"demo.{{$timestamp}}@example.com\",\n  \"phone\": \"0901234567\"\n}"
            }
          }
        },
        {
          "name": "Login as customer1 (CUSTOMER)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
