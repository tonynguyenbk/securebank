        {
          "name": "Transfer 1,000,000 VND (new key)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/transfers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "transfers"
              ]
            },
            "description": "Generates a fresh Idempotency-Key before sending.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceAccountNumber\": \"1000000001\",\n  \"destinationAccountNumber\": \"1000000002\",\n  \"amount\": 1000000.0,\n  \"currency\": \"VND\",\n  \"description\": \"Demo transfer\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('idempotencyKey', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const tx = pm.response.json();",
                  "pm.collectionVariables.set('transactionId', tx.transactionId);",
                  "pm.test('two ledger lines', () => pm.expect(tx.ledgerEntries.length).to.eql(2));"
                ]
              }
            }
          ]
        },
        {
          "name": "Replay the same transfer (same key, no money moves)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/transfers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "transfers"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceAccountNumber\": \"1000000001\",\n  \"destinationAccountNumber\": \"1000000002\",\n  \"amount\": 1000000.0,\n  \"currency\": \"VND\",\n  \"description\": \"Demo transfer\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('replayed', () => pm.expect(pm.response.headers.get('Idempotent-Replayed')).to.eql('true'));",
                  "pm.test('same transaction', () => pm.expect(pm.response.json().transactionId).to.eql(pm.collectionVariables.get('transactionId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Same key, different amount: 409",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
